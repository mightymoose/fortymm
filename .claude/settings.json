{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git push *--force-with-lease*)",
      "Bash(~/.claude/skills/ship-it/review-threads.sh *)",
      "Bash(/Users/ryan/.claude/skills/ship-it/review-threads.sh *)",
      "Bash(gh pr merge *--squash*)",
      "Bash(gh pr comment *)",
      "Bash(gh pr edit *)",
      "Bash(gh issue create *)",
      "Bash(gh issue comment *)",
      "Bash(bin/teardown-stack *)",
      "Bash(./bin/teardown-stack *)",
      "Bash(git worktree remove *)",
      "Bash(git branch -D *)"
    ],
    "ask": [
      "Bash(git push *--receive-pack*)",
      "Bash(git push *--exec*)",
      "Bash(git branch -D *main*)",
      "Bash(gh pr * -R*)",
      "Bash(gh pr * --repo*)",
      "Bash(gh pr * -F*)",
      "Bash(gh pr * --body-file*)",
      "Bash(gh issue * -R*)",
      "Bash(gh issue * --repo*)",
      "Bash(gh issue * -F*)",
      "Bash(gh issue * --body-file*)"
    ],
    "deny": [
      "Bash(git push *-f* main)",
      "Bash(git push *-f* main *)",
      "Bash(git push *-f*:main)",
      "Bash(git push *-f*:main *)",
      "Bash(git push * main *-f*)",
      "Bash(git push *:main *-f*)",
      "Bash(git push *+main)",
      "Bash(git push *+main *)",
      "Bash(git push *+*:main)",
      "Bash(git push *+*:main *)",
      "Bash(git branch -D main)",
      "Bash(gh pr merge *--admin*)",
      "Bash(gh api graphql *mergePullRequest*)"
    ]
  }
}
