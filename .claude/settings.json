{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git push *--force-with-lease*)",
      "Bash(gh api graphql *)",
      "Bash(gh pr merge *--squash*)",
      "Bash(gh pr comment *)",
      "Bash(gh pr edit *)",
      "Bash(gh issue create *)",
      "Bash(gh issue comment *)",
      "Bash(docker compose -p fortymm-* down --volumes --remove-orphans)",
      "Bash(docker ps -a --filter label=com.docker.compose.project=fortymm-*)",
      "Bash(docker volume ls --filter label=com.docker.compose.project=fortymm-*)",
      "Bash(docker network ls --filter label=com.docker.compose.project=fortymm-*)",
      "Bash(docker rm -f fortymm-*)",
      "Bash(docker volume rm fortymm-*)",
      "Bash(docker network rm fortymm-*)",
      "Bash(git worktree remove *)",
      "Bash(git branch -D *)"
    ],
    "deny": [
      "Bash(git push *-f* main)",
      "Bash(git push *-f* main *)",
      "Bash(git push *-f*:main)",
      "Bash(git push *-f*:main *)",
      "Bash(git push * main *-f*)",
      "Bash(git push *:main *-f*)",
      "Bash(git push *+main)",
      "Bash(git push *+main *)",
      "Bash(git push *+*:main)",
      "Bash(git push *+*:main *)",
      "Bash(git branch -D main)",
      "Bash(gh pr merge *--admin*)",
      "Bash(gh api graphql *mergePullRequest*)"
    ]
  }
}
