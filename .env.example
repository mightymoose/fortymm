# Template for the UAT runtime secrets file. Copy to `.env` and fill in.
# The real `.env` is gitignored; this template is committed.

SMTP_HOST=smtp.postmarkapp.com
SMTP_PORT=587
SMTP_USE_TLS=true
# Postmark Server API Token, used as BOTH username and password.
SMTP_USERNAME=
SMTP_PASSWORD=

# Address on a verified Postmark sender domain.
EMAIL_FROM=FortyMM <noreply@fortymm.com>

# Public URL the API renders into confirmation/sign-in email links.
APP_BASE_URL=https://uat.fortymm.com

# Public identity admission; existing sessions do not consume budgets.
# Login email requests share this budget without disclosing address ownership.
# Exhaustion skips new identity allocation but preserves existing-account sign-in.
# Redis must be available for admission. Defaults apply to production and UAT.
GUEST_CREATION_IP_LIMIT_PER_HOUR=60
GUEST_CREATION_IP_LIMIT_PER_DAY=300

# Shared HTTP/MCP standalone match admission; automatic tournament matches exempt.
# Expiring per-Account budgets require Redis before new match rows are written.
MATCH_CREATION_ACCOUNT_LIMIT_PER_HOUR=60
MATCH_CREATION_ACCOUNT_LIMIT_PER_DAY=300

# --- Tournament checkout launch merchant ---
# Account UUID for Ryan's launch merchant. Paid checkout holds fail closed when
# this is unset, and only tournaments owned by this account advertise checkout.
# This is deployment configuration, not a per-tournament activation switch.
# TOURNAMENT_PAYMENT_MERCHANT_ACCOUNT_ID=00000000-0000-0000-0000-000000000000
# Fail closed until the complete card-payment release has passed acceptance. This
# flag also hides and rejects positive event-fee authoring. Changing it requires a
# process/pod rollout; it is not an instantaneous emergency switch. Helm
# deployments set this through config values; uncomment this for local runs.
# TOURNAMENT_PAYMENT_COLLECTION_ENABLED=false
# Stripe's server-side key belongs only in the environment's secret store. The
# API version is pinned in application config so provider behavior cannot drift
# when Stripe changes its account default.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_LIVEMODE=false
# STRIPE_API_VERSION=2024-12-18.acacia

# --- Auth0 / MCP OAuth Resource Server ---
# The MCP server trusts Auth0 as its OAuth Authorization Server; see
# docs/adr/20260722-the-mcp-server-is-an-oauth-resource-server-trusting-auth0.md.
# The non-secret vars below are also set in deploy/environments/uat.yaml (rendered
# into the api-config ConfigMap); they live here too so the operator sees the
# full set.

# Auth0 tenant domain (the JWT issuer), e.g. fortymm.us.auth0.com.
AUTH0_DOMAIN=
# Auth0 API identifier for the MCP Resource Server — the token `aud` claim.
AUTH0_AUDIENCE=
# Public base URL the MCP server advertises (nginx strips /api at the edge).
MCP_PUBLIC_BASE_URL=https://uat.fortymm.com/api
# Public MCP resource URL used in the RFC 9728 protected-resource metadata.
MCP_PUBLIC_RESOURCE_URL=https://uat.fortymm.com/api/mcp

# --- Server-side geocoding ---
# Which geocoder the API uses for venue addresses at write time — `google` or
# `fake`; see
# docs/adr/20260725-a-venues-coordinates-are-geocoded-server-side-and-not-null.md
# ("The geocoder is selected by explicit config, not inferred from key
# presence"). `fake` is the deterministic, network-free FakeGeocoder intended
# for local dev, CI, e2e and QA; `google` is the real one and needs the key
# below. The choice is explicit on purpose: the test double must be asked for
# by name, so no environment can silently store hash-derived coordinates as
# though they were real.
#
# **GEOCODER is deliberately NOT set here, and must not be added.** Every
# environment already declares it where that environment is defined: the compose
# stacks in their services' `environment:` blocks (which beat `env_file`), UAT in
# deploy/environments/uat.yaml, CI at the workflow level, the test suite in
# api/tests/__init__.py, and scripts/ensure-api-up.sh for a local type regen.
#
# Setting it here would quietly outrank the one that matters. redeploy-uat.sh
# syncs this whole file into the fortymm-uat-env Secret, and the chart's
# appEnvFrom applies that Secret AFTER the api-config ConfigMap — so a stale line
# in an operator's untracked .env silently beats deploy/environments/uat.yaml. Both said
# `fake` while that line existed, so nothing broke; the day UAT moves to `google`
# (#1205) is the day it would have, with no error and hash-derived coordinates
# written as though real. That is the exact failure this whole change repairs, so
# the line is gone rather than annotated with a request to keep two files in step
# by hand.
#
# The key below IS a secret and belongs here; the *choice* of geocoder is config
# and belongs with each environment.

# Google Geocoding API key, required when GEOCODER=google (and unused
# otherwise). Only UAT/prod set it; redeploy-uat.sh loads it into the
# fortymm-uat-env Secret, from which the api pod reads it.
GOOGLE_GEOCODING_API_KEY=

# --- Browser maps (baked into the web bundle at build time) ---
# Browser Google Maps JS API key, exposed to the web client via
# import.meta.env.VITE_GOOGLE_MAPS_API_KEY. OPTIONAL: leave blank and the map
# degrades to a text fallback (the intended default for dev, CI, e2e, and QA).
# Being VITE_-prefixed it is baked into the bundle at build time, which is why
# this line no longer reaches UAT: UAT runs the web image CI publishes, and that
# image was built before this file was ever read. For UAT/prod the key is the
# `VITE_GOOGLE_MAPS_API_KEY` REPOSITORY SECRET consumed by
# .github/workflows/publish.yml — setting it here has no effect there.
# This line still applies to the QA/dev compose stacks, which do build locally
# and accept it as a build arg / dev-server env. Distinct from the server-side
# GOOGLE_GEOCODING_API_KEY above.
VITE_GOOGLE_MAPS_API_KEY=
