#!/usr/bin/env bash
# A stand-in for gh, for tests/preview-comment.sh: it answers the listing of a
# pull request's comments with the pages in STAND_IN_PAGES (files, one JSON
# array each, printed one after another as gh api --paginate does), and logs
# every request that would change something to STAND_IN_LOG, as
# "<METHOD> <path>", then the body it would send, then "--". It changes
# nothing.
set -euo pipefail
[ "${1:-}" = api ] || { echo "stand-in gh: only 'gh api' is expected, got: $*" >&2; exit 2; }
shift
method=GET path="" body=""
while [ "$#" -gt 0 ]; do
  case "$1" in
    --method) method=$2; shift 2 ;;
    --paginate) shift ;;
    --jq) shift 2 ;;
    -F)
      case "$2" in
        body=@*) body=$(cat "${2#body=@}") ;;
        *) echo "stand-in gh: unexpected field $2" >&2; exit 2 ;;
      esac
      shift 2
      ;;
    -*) echo "stand-in gh: unexpected flag $1" >&2; exit 2 ;;
    *) path=$1; shift ;;
  esac
done
if [ "$method" = GET ]; then
  case "$path" in
    repos/*/issues/*/comments)
      for page in ${STAND_IN_PAGES:-}; do cat "$page"; done
      ;;
    *) echo "stand-in gh: unexpected GET $path" >&2; exit 2 ;;
  esac
  exit 0
fi
{ echo "$method $path"; echo "$body"; echo "--"; } >>"$STAND_IN_LOG"
