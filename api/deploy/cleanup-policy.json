[
  {
    "name": "delete-older-than-30-days",
    "action": {"type": "Delete"},
    "condition": {
      "tagState": "any",
      "olderThan": "30d"
    }
  },
  {
    "name": "keep-10-most-recent-api",
    "action": {"type": "Keep"},
    "mostRecentVersions": {
      "packageNamePrefixes": ["api"],
      "keepCount": 10
    }
  },
  {
    "name": "keep-production",
    "action": {"type": "Keep"},
    "condition": {
      "tagState": "tagged",
      "tagPrefixes": ["production"]
    }
  }
]
