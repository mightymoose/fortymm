#!/usr/bin/env bash
# Push the fortymm-api-production image (built by `mise run api:build`) to
# Artifact Registry and deploy it to Cloud Run. Run through `mise run api:deploy` or
# `mise run api:preview`, which set GCP_PROJECT and GCP_REGION; needs gcloud,
# authenticated as an account that can deploy (see api/deploy/README.md).
#
#   cloud-run-deploy             production: the `api` service, all traffic
#   cloud-run-deploy --tag NAME  a Preview: a revision of `api-preview` tagged
#                                NAME, with no traffic
#
# Everything but the URL the deploy is served on goes to stderr, so the last
# line of stdout is that URL (the service's, or the tagged revision's).
set -euo pipefail

: "${GCP_PROJECT:?}" "${GCP_REGION:?}"
tag=
if [ "${1:-}" = --tag ]; then
  tag=${2:?usage: cloud-run-deploy [--tag NAME]}
fi

registry="$GCP_REGION-docker.pkg.dev"
image="$registry/$GCP_PROJECT/fortymm/api:$(git rev-parse HEAD)"
gcloud auth configure-docker "$registry" --quiet >&2
docker tag fortymm-api-production "$image" >&2
docker push --quiet "$image" >&2

gcloud_args=(--project "$GCP_PROJECT" --region "$GCP_REGION")
# A version number, never `latest`: instances scale to zero and would read
# `latest` again on each cold start, so a rotation would reach the API before
# the Worker. CI pins WORKER_SECRET_VERSION so both deploys use one version.
version=${WORKER_SECRET_VERSION:-$(gcloud secrets versions list api-worker-secret \
  --project "$GCP_PROJECT" --filter=state=ENABLED --sort-by=~createTime --limit=1 \
  --format='value(name.basename())')}
: "${version:?api-worker-secret has no enabled version (see api/deploy/README.md)}"

# Production and the Previews share the Cloud SQL instance. Production has
# its own database, user and password secret, and runs as its own service
# account, so a Preview can't read production's password. The Previews share
# one user, but each gets its own database, because the API migrates it at
# startup and two branches can have different schemas.
if [ -z "$tag" ]; then
  service=api
  runtime=api-runtime
  db_user=api
  db_name=fortymm
  db_password=api-database-password
  max_instances=3
else
  service=api-preview
  runtime=api-preview-runtime
  db_user=api_preview
  db_name=$("$(dirname "$0")/preview-database" create "$tag")
  db_password=api-preview-database-password
  max_instances=1
fi
instance="$GCP_PROJECT:$GCP_REGION:fortymm"

# Scale to zero, keep the max small, smallest sensible size. Unauthenticated
# at the Cloud Run level: the API itself rejects requests without the Worker
# secret, which only the Cloudflare Worker sends.
#
# The API reaches the database over the Cloud SQL socket that
# --add-cloudsql-instances mounts, and libpq reads the password from
# PGPASSWORD. The password secret uses `latest`, unlike the Worker secret: it
# only changes together with the database user, so a cold start should read
# the newest one. --set-secrets replaces every secret, so both go in one flag.
deploy_args=(
  --image "$image"
  --service-account "$runtime@$GCP_PROJECT.iam.gserviceaccount.com"
  --port 8080
  --cpu 1
  --memory 256Mi
  --min-instances 0
  --max-instances "$max_instances"
  --allow-unauthenticated
  --add-cloudsql-instances "$instance"
  --set-env-vars "DATABASE_URL=postgresql://$db_user@/$db_name?host=/cloudsql/$instance"
  --set-secrets "WORKER_SECRET=api-worker-secret:$version,PGPASSWORD=$db_password:latest"
  --quiet
)

if [ -z "$tag" ]; then
  gcloud run deploy "$service" "${gcloud_args[@]}" "${deploy_args[@]}" >&2
  # Move the `production` tag to the image now serving, once the deploy has
  # succeeded: the repository's cleanup policy (cleanup-policy.json) never
  # deletes it, however old it gets.
  gcloud artifacts docker tags add "$image" "${image%:*}:production" \
    --project "$GCP_PROJECT" --quiet >&2
else
  # Previews get their own service, so they can never move production's
  # traffic. --no-traffic only works on a service that exists already.
  no_traffic=--no-traffic
  gcloud run services describe "$service" "${gcloud_args[@]}" >/dev/null 2>&1 || no_traffic=
  gcloud run deploy "$service" "${gcloud_args[@]}" "${deploy_args[@]}" \
    --tag "$tag" $no_traffic >&2
fi

url=$(gcloud run services describe "$service" "${gcloud_args[@]}" --format='value(status.url)')
if [ -n "$tag" ]; then
  # A tagged revision is served on the service's host with "<tag>---" in front.
  url="https://$tag---${url#https://}"
fi
echo "$url"
