#!/usr/bin/env bash
#
# A wizard walks a human through a manual procedure, step by step.
# Generated by the /wizard skill.
#
# Everything above the "STAGES" marker is the wizard library: do not hand-edit
# it. Author the per-step stages below the marker.

set -euo pipefail

# ──────────────────────────────────────────────────────────────────────────
# Wizard library: delightful, consistent UX, identical across every wizard.
# ──────────────────────────────────────────────────────────────────────────

if [[ -t 1 ]] && command -v tput >/dev/null 2>&1 && [[ "$(tput colors 2>/dev/null || echo 0)" -ge 8 ]]; then
  BOLD=$(tput bold); DIM=$(tput dim); RESET=$(tput sgr0)
  BLUE=$(tput setaf 4); GREEN=$(tput setaf 2); YELLOW=$(tput setaf 3); RED=$(tput setaf 1)
else
  BOLD=""; DIM=""; RESET=""; BLUE=""; GREEN=""; YELLOW=""; RED=""
fi

# Author sets this at the top of the stages section.
TOTAL_STAGES=0

_STAGE_INDEX=0
ENV_FILE="${ENV_FILE:-.env}"
WRITTEN_ENV=()    # KEYs written to ENV_FILE this run
WRITTEN_SECRET=() # secret NAMEs set this run
SKIPPED=()        # things we couldn't do (e.g. gh missing)

# _clear wipes the terminal so only the current step is on screen. No-op when
# output isn't a terminal, so piped logs stay readable.
_clear() {
  [[ -t 1 ]] || return 0
  if command -v tput >/dev/null 2>&1; then tput clear; else printf '\033[2J\033[3J\033[H'; fi
}

# banner "Title" shows the opening frame: what this wizard does.
banner() {
  _clear
  printf '\n%s%s  %s%s\n' "$BOLD" "$BLUE" "$1" "$RESET"
  printf '%s  %s stages%s\n\n' "$DIM" "$TOTAL_STAGES" "$RESET"
  printf '%s  You drive the browser; this wizard tells you exactly what to do and\n' "$DIM"
  printf '  captures the values you copy back. Stop any time with Ctrl-C and re-run\n'
  printf '  later, since it remembers values already saved.%s\n' "$RESET"
  pause "Ready to start?"
}

# stage "Name" clears the screen, then announces a stage and shows progress.
# Clearing keeps only the current step on screen.
stage() {
  _clear
  _STAGE_INDEX=$((_STAGE_INDEX + 1))
  printf '\n%s%s▸ Stage %s/%s · %s%s\n' \
    "$BOLD" "$BLUE" "$_STAGE_INDEX" "$TOTAL_STAGES" "$1" "$RESET"
}

# say "..." prints a plain instruction line.
say()  { printf '  %s\n' "$1"; }
# step "..." is a numbered-feeling action the human takes in the browser.
step() { printf '  %s•%s %s\n' "$BLUE" "$RESET" "$1"; }
note() { printf '  %s%s%s\n' "$DIM" "$1" "$RESET"; }
warn() { printf '  %s⚠ %s%s\n' "$YELLOW" "$1" "$RESET"; }

# open_url URL opens it in the human's browser, cross-platform incl. WSL.
open_url() {
  local url="$1"
  printf '  %s↗ opening%s %s\n' "$GREEN" "$RESET" "$url"
  { if   command -v wslview     >/dev/null 2>&1; then wslview "$url"
    elif command -v explorer.exe >/dev/null 2>&1; then explorer.exe "$url"
    elif command -v xdg-open    >/dev/null 2>&1; then xdg-open "$url"
    elif command -v open        >/dev/null 2>&1; then open "$url"
    else warn "couldn't open a browser; visit it manually: $url"; fi
  } >/dev/null 2>&1 || warn "couldn't open a browser, so visit it manually: $url"
}

# pause "msg" waits for the human to confirm they've done the manual part.
pause() {
  printf '  %s%s%s ' "$DIM" "${1:-Press Enter to continue}" "$RESET"
  read -r _ || true
}

# confirm "question" is a y/N gate; returns success on yes.
confirm() {
  local reply=""
  printf '  %s? %s [y/N] ' "$YELLOW" "$1"
  read -r reply || true
  [[ "$reply" =~ ^[Yy] ]]
}

# _existing KEY: current value of KEY in ENV_FILE, if any.
_existing() {
  [[ -f "$ENV_FILE" ]] || return 1
  local line; line=$(grep -E "^${1}=" "$ENV_FILE" | tail -n1) || return 1
  printf '%s' "${line#*=}"
}

# ask KEY "Prompt" reads a value into $KEY. Offers the existing .env value as
# a default on re-runs (Enter keeps it). Visible input (non-secret).
ask() {
  local key="$1" prompt="$2" current input
  current=$(_existing "$key" || true)
  if [[ -n "$current" ]]; then
    printf '  %s%s%s %s[Enter keeps current]%s ' "$BOLD" "$prompt" "$RESET" "$DIM" "$RESET"
  else
    printf '  %s%s%s ' "$BOLD" "$prompt" "$RESET"
  fi
  read -r input || true
  [[ -z "$input" && -n "$current" ]] && input="$current"
  printf -v "$key" '%s' "$input"
}

# ask_secret KEY "Prompt" is like ask, but input is hidden.
ask_secret() {
  local key="$1" prompt="$2" current input
  current=$(_existing "$key" || true)
  if [[ -n "$current" ]]; then
    printf '  %s%s%s %s[Enter keeps current]%s ' "$BOLD" "$prompt" "$RESET" "$DIM" "$RESET"
  else
    printf '  %s%s%s ' "$BOLD" "$prompt" "$RESET"
  fi
  read -rs input || true
  printf '\n'
  [[ -z "$input" && -n "$current" ]] && input="$current"
  printf -v "$key" '%s' "$input"
}

# write_env KEY VALUE upserts KEY=VALUE into ENV_FILE (creates it; replaces
# any existing line). Idempotent.
write_env() {
  local key="$1" value="$2" tmp
  touch "$ENV_FILE"
  tmp=$(mktemp)
  grep -vE "^${key}=" "$ENV_FILE" > "$tmp" || true
  printf '%s=%s\n' "$key" "$value" >> "$tmp"
  mv "$tmp" "$ENV_FILE"
  WRITTEN_ENV+=("$key")
  printf '  %s✓ wrote%s %s → %s\n' "$GREEN" "$RESET" "$key" "$ENV_FILE"
}

# set_secret NAME VALUE sets a GitHub Actions repo secret via gh. Falls back
# to a warning (and records it) if gh is unavailable or unauthenticated.
set_secret() {
  local name="$1" value="$2"
  if command -v gh >/dev/null 2>&1 && gh auth status >/dev/null 2>&1; then
    if printf '%s' "$value" | gh secret set "$name" >/dev/null 2>&1; then
      WRITTEN_SECRET+=("$name")
      printf '  %s✓ set%s GitHub secret %s\n' "$GREEN" "$RESET" "$name"
      return
    fi
  fi
  SKIPPED+=("GitHub secret $name (set it manually: gh secret set $name)")
  warn "skipped GitHub secret $name: gh not ready; set it later"
}

# set_var NAME VALUE sets a GitHub Actions repo variable (non-secret).
set_var() {
  local name="$1" value="$2"
  if command -v gh >/dev/null 2>&1 && gh auth status >/dev/null 2>&1; then
    if gh variable set "$name" --body "$value" >/dev/null 2>&1; then
      printf '  %s✓ set%s GitHub variable %s\n' "$GREEN" "$RESET" "$name"
      return
    fi
  fi
  SKIPPED+=("GitHub variable $name")
  warn "skipped GitHub variable $name, gh not ready; set it later"
}

# finish clears, then shows a closing summary of everything configured.
finish() {
  _clear
  printf '\n%s%s  ✓ Setup complete%s\n' "$BOLD" "$GREEN" "$RESET"
  (( ${#WRITTEN_ENV[@]} ))    && note "wrote ${#WRITTEN_ENV[@]} value(s) to $ENV_FILE: ${WRITTEN_ENV[*]}"
  (( ${#WRITTEN_SECRET[@]} )) && note "set ${#WRITTEN_SECRET[@]} GitHub secret(s): ${WRITTEN_SECRET[*]}"
  if (( ${#SKIPPED[@]} )); then
    printf '\n'; warn "still to do by hand:"
    for s in "${SKIPPED[@]}"; do note "  - $s"; done
  fi
  printf '\n'
}


# ──────────────────────────────────────────────────────────────────────────
# STAGES: author this section. One stage() per step the human takes.
# ──────────────────────────────────────────────────────────────────────────
#
# Makes Auth0 send its email codes through Postmark over SMTP, from
# fortymm.com, instead of Auth0's built-in provider (see api/deploy/README.md).
# Run it from anywhere after setup-auth0:
#
#   api/deploy/setup-email
#
# The SMTP token goes from Postmark straight into Auth0's form. The wizard
# never asks for it, and it writes no file.

ENV_FILE=/dev/null
DOMAIN=fortymm.com
DEFAULT_FROM="FortyMM <no-reply@$DOMAIN>"

# stdin_closed stops the wizard. A check that waits for Enter would otherwise
# retry forever once stdin is at its end.
stdin_closed() {
  printf '\n'
  warn "stdin closed, so the wizard stops here. Run it again in a terminal."
  exit 1
}

# need KEY "Prompt" reads a value that can't be empty into $KEY.
need() {
  local key="$1" prompt="$2" input
  while :; do
    printf '  %s%s%s ' "$BOLD" "$prompt" "$RESET"
    read -r input || stdin_closed
    [[ -n "$input" ]] && break
    warn "that is empty. Paste it again."
  done
  printf -v "$key" '%s' "$input"
}

# normalize strips quotes and whitespace. Cloudflare and dig split a long TXT
# value into quoted chunks, so only the joined text compares.
normalize() { tr -d '" \t\n'; }

# A public resolver caches the NXDOMAIN of a check made before the record
# exists, so the checks ask a server that is authoritative for the domain.
NS=""
if command -v dig >/dev/null 2>&1; then
  NS=$(dig +short NS "$DOMAIN" 2>/dev/null | head -n1 || true)
fi

# check_record NAME TYPE WANT HINT waits until dig shows WANT for NAME. WANT
# is already normalized. HINT is the likely cause of a mismatch.
check_record() {
  local name="$1" type="$2" want="$3" hint="$4" raw
  if [[ -z "$NS" ]]; then
    warn "dig can't reach $DOMAIN's name servers, so check $name in Cloudflare yourself."
    pause "Press Enter when the record is there."
    return
  fi
  while :; do
    raw=$(dig +short @"$NS" "$type" "$name" 2>/dev/null || true)
    if [[ "$(printf '%s' "$raw" | normalize)" == "$want" ]]; then
      printf '  %s✓%s %s %s is in DNS\n' "$GREEN" "$RESET" "$type" "$name"
      return
    fi
    warn "$NS doesn't show the expected $type record for $name yet."
    note "    expected: $want"
    note "    dig said: ${raw:-(nothing)}"
    note "  $hint"
    printf '  %sPress Enter to check again.%s ' "$DIM" "$RESET"
    read -r _ || stdin_closed
  done
}

TOTAL_STAGES=10

banner "Postmark email for FortyMM's Auth0 tenant"

stage "Check the Postmark account is approved"
say "Auth0's built-in provider sends at most 10 emails a minute, from"
say "no-reply@auth0user.net, and Auth0 says it doesn't support production use."
open_url "https://account.postmarkapp.com/"
step "Log in, then open ${BOLD}Account${RESET}."
step "If the account still waits for approval, submit the approval request there."
note "  Only the Account Owner can submit it. Review takes under 24 hours on weekdays."
note "  Until then, Postmark sends only to addresses on its verified domains."
note "  So the Auth0 test email and a sign-in to a gmail address fail."
if ! confirm "Is the account approved?"; then
  SKIPPED+=("wait for Postmark to approve the account, then send Auth0's test email again")
  say "Go on. The DNS stages don't need the approval."
  pause
fi

stage "Postmark server"
open_url "https://account.postmarkapp.com/servers"
step "Open the server for FortyMM, or select Create Server and name it ${BOLD}FortyMM${RESET}."
step "Its type must be ${BOLD}Live${RESET}. A Sandbox server never delivers email."
note "  A server's type can't change later. If it is Sandbox, make a new Live one."
step "Open the server's ${BOLD}Settings${RESET}. Make sure SMTP is turned on, then save."
pause "Press Enter when the Live server has SMTP on."

stage "Add the domain"
open_url "https://account.postmarkapp.com/signatures"
step "Sender Signatures > Add Domain. Enter ${BOLD}$DOMAIN${RESET}."
step "Open the domain's ${BOLD}DNS Settings${RESET}, and keep that page open."
note "  The next four stages copy from it."
say "$DOMAIN receives mail through Cloudflare Email Routing. Its MX, SPF"
say "and cf2024-1._domainkey records stay as they are. Postmark's DKIM,"
say "Return-Path and DMARC records sit beside them with no conflict."
note "  Postmark aligns SPF through the Return-Path, so the SPF record needs no"
note "  Postmark include."
pause

stage "DKIM record"
step "In Postmark's DNS Settings, find the DKIM record. Copy its Hostname."
need DKIM_HOST "Paste the Hostname:"
DKIM_HOST=$(printf '%s' "$DKIM_HOST" | normalize | tr '[:upper:]' '[:lower:]')
DKIM_HOST=${DKIM_HOST%.}
DKIM_HOST=${DKIM_HOST%".$DOMAIN"}
step "Copy the DKIM record's Value."
need DKIM_VALUE "Paste the Value:"
open_url "https://dash.cloudflare.com/"
step "$DOMAIN > DNS > Records > Add record. Fill in:"
note "    Type:    TXT"
note "    Name:    $DKIM_HOST"
note "    Content: $DKIM_VALUE"
step "Save."
pause "Press Enter when the record is saved."
check_record "$DKIM_HOST.$DOMAIN" TXT "$(printf '%s' "$DKIM_VALUE" | normalize)" \
  "Check that Name and Content match what Postmark shows."
pause

stage "Return-Path record"
step "In Postmark's DNS Settings, set the Return-Path to ${BOLD}pm-bounces${RESET}."
step "In Cloudflare, $DOMAIN > DNS > Records > Add record. Fill in:"
note "    Type:         CNAME"
note "    Name:         pm-bounces"
note "    Target:       pm.mtasv.net"
note "    Proxy status: DNS only (grey cloud)"
warn "A proxied CNAME breaks the Return-Path."
step "Save."
pause "Press Enter when the record is saved."
check_record "pm-bounces.$DOMAIN" CNAME "pm.mtasv.net." \
  "If dig said nothing, set Proxy status to DNS only. A proxied record hides its CNAME."
pause

stage "DMARC record"
say "p=none publishes a DMARC policy and tells receivers to deliver as usual."
step "In Cloudflare, $DOMAIN > DNS > Records > Add record. Fill in:"
note "    Type:    TXT"
note "    Name:    _dmarc"
note "    Content: v=DMARC1; p=none"
step "Save."
pause "Press Enter when the record is saved."
check_record "_dmarc.$DOMAIN" TXT "v=DMARC1;p=none" \
  "Check that $DOMAIN has one _dmarc record, with the content above."
pause

stage "Verify the domain in Postmark"
step "In Postmark's DNS Settings, select ${BOLD}Verify${RESET} next to DKIM."
step "Select ${BOLD}Verify${RESET} next to Return-Path."
note "  Postmark can take up to 48 hours to see a record, but it usually takes minutes."
if ! confirm "Do both show as verified?"; then
  SKIPPED+=("in Postmark's DNS Settings for $DOMAIN, verify DKIM and Return-Path")
fi

stage "SMTP token"
open_url "https://account.postmarkapp.com/servers"
step "Open the FortyMM server, then its ${BOLD}Default Transactional Stream${RESET}."
step "Open the stream's ${BOLD}Settings${RESET}. Under SMTP token, select Generate."
say "The Access Key is the SMTP username, and the Secret Key is the password."
warn "Postmark shows the Secret Key once. After a reload it is gone."
note "  If you lose it, generate another token."
note "  Use this stream's token, not the Server API token. Auth0 can't send the"
note "  header that picks a stream, and the stream token needs none."
step "Keep the page open. The next stage pastes both keys into Auth0."
note "  This wizard never asks for them. Only Auth0 keeps them."
pause

stage "Auth0 email provider"
say "Postmark rejects a From address that isn't on $DOMAIN."
from=""
from_pattern="@${DOMAIN//./[.]}>?\$"
while :; do
  ask from "From address [Enter keeps $DEFAULT_FROM]:"
  from=${from:-$DEFAULT_FROM}
  [[ "$from" =~ $from_pattern ]] && break
  warn "that address isn't on $DOMAIN."
done
open_url "https://manage.auth0.com/"
step "Branding > Email Provider. Turn on ${BOLD}Use my own email provider${RESET}."
step "Choose ${BOLD}SMTP${RESET}, then fill in:"
note "    From:     $from"
note "    Host:     smtp.postmarkapp.com"
note "    Port:     587"
note "    Username: the Access Key from Postmark"
note "    Password: the Secret Key from Postmark"
step "Save."
step "Select ${BOLD}Send Test Email${RESET}."
note "  If nothing arrives in a few minutes, look for failures in Monitoring > Logs."
if ! confirm "Did the test email arrive from $from?"; then
  SKIPPED+=("send Auth0's test email again, and check Monitoring > Logs if it doesn't arrive")
fi

stage "Email code sender"
say "Auth0 uses the email provider for email codes only if this From isn't"
say "its default address on auth0.com."
open_url "https://manage.auth0.com/#/connections/passwordless"
step "Authentication > Passwordless > ${BOLD}Email${RESET} > Settings."
step "Set From to:"
note "    $from"
step "Leave Subject and Message as they are. Save."
pause "Press Enter when the From is saved."

SKIPPED+=("on a Preview, sign in with an email code to a gmail address")
SKIPPED+=("check that the email comes from $from")
SKIPPED+=("check that Postmark's Activity page shows the email as delivered")
finish
