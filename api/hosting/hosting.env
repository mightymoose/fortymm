# The api's preview hosting on Google Cloud: every name the scripts in this
# directory and the workflows (.github/workflows/ci.yml,
# preview-cleanup.yml) need, in one place. None of it is a secret. Plain
# KEY=value lines, no quotes and no expansion: shell scripts source this file
# and the workflows read it as step outputs. setup.sh creates what these
# name; api/README.md, "Hosting", describes each.
PROJECT=fortymm
PROJECT_NUMBER=89514061125
REGION=northamerica-northeast2

# Who may deploy: GitHub Actions in this repository, and nothing else. The
# numeric ID survives a rename and can't be taken by a new repository of the
# same name (gh api repos/mightymoose/fortymm --jq .id).
GITHUB_REPOSITORY=mightymoose/fortymm
GITHUB_REPOSITORY_ID=1451920058
WORKLOAD_IDENTITY_POOL=github-actions
WORKLOAD_IDENTITY_PROVIDER=projects/89514061125/locations/global/workloadIdentityPools/github-actions/providers/fortymm

# What GitHub Actions becomes, and what the previews run as.
DEPLOYER=api-preview-deployer@fortymm.iam.gserviceaccount.com
RUNTIME=api-preview-runtime@fortymm.iam.gserviceaccount.com

# The shared PostgreSQL instance, the one role every preview connects as, and
# the secret holding its password.
INSTANCE=fortymm-api-preview
DATABASE_USER=api_preview
PASSWORD_SECRET=api-preview-database-password

# Where the previews' images go: one package per preview,
# <IMAGE_REPOSITORY>/<preview>, e.g. .../fortymm-api-preview/pr-9.
IMAGE_REPOSITORY=fortymm-api-preview

# A pull request's preview is the Cloud Run service fortymm-api-pr-<number>,
# with the database pr_<number> and the image package pr-<number>.
# fortymm-api-trial (database trial) is for trying a branch by hand.
SERVICE_PREFIX=fortymm-api-
