{
  "openapi": "3.1.0",
  "info": {
    "title": "FortyMM API",
    "version": "0.1.0"
  },
  "paths": {
    "/v1/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Health",
        "description": "Check that the API can reach its database.",
        "operationId": "health",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/session": {
      "post": {
        "tags": [
          "session"
        ],
        "summary": "Start Session",
        "description": "Resume the visitor's session, or start a guest account and its session.\n\nA valid session gets a later expiry and a fresh cookie. With no cookie, or\na cookie for an expired, unknown or adopted session, the visitor gets a\nnew guest account. The API deletes the session that cookie named. A\nclient network can start 30 guest accounts a minute. Past that, the API\nanswers 429.\n\nThe account's player is the one it plays as. A new guest account's player\ngets a default display name, such as `excited egret 387`. A verified\naccount has its email, and can have no player.",
        "operationId": "start_session",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionResponse"
                }
              }
            }
          },
          "429": {
            "description": "The client's network started too many guest accounts. Retry-After gives the seconds until it can start more."
          }
        },
        "security": [
          {
            "session": []
          }
        ]
      }
    },
    "/v1/auth/login": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "Login",
        "description": "Send the visitor to the identity provider's sign-in page.\n\nA request with no valid session gets a guest account first. After\nsign-in, the callback sends the visitor to `return_to`. It must be a path\non this site, or the callback uses `/`.",
        "operationId": "login",
        "security": [
          {
            "session": []
          }
        ],
        "parameters": [
          {
            "name": "return_to",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Return To"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "A redirect"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/callback": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "Callback",
        "description": "Finish a sign-in, then send the visitor back to its `return_to`.\n\nA failed sign-in adds `sign_in_error` to that path's query: `cancelled`,\n`email_not_verified`, `expired` or `failed`. A callback whose `state`\nmatches no login attempt, such as a replay, goes to `/`.",
        "operationId": "callback",
        "security": [
          {
            "session": []
          }
        ],
        "parameters": [
          {
            "name": "state",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "State"
            }
          },
          {
            "name": "code",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Code"
            }
          },
          {
            "name": "error",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Error"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "A redirect"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/logout": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Logout",
        "description": "End the visitor's session and expire its cookie.\n\n`logout_url` is the identity provider's logout page. The client follows\nit, so the provider's own session ends too.",
        "operationId": "logout",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LogoutResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "session": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "data": {
            "$ref": "#/components/schemas/HealthStatus"
          }
        },
        "type": "object",
        "required": [
          "data"
        ],
        "title": "HealthResponse"
      },
      "HealthStatus": {
        "properties": {
          "database": {
            "type": "string",
            "const": "ok",
            "title": "Database"
          }
        },
        "type": "object",
        "required": [
          "database"
        ],
        "title": "HealthStatus"
      },
      "LogoutData": {
        "properties": {
          "logout_url": {
            "type": "string",
            "title": "Logout Url"
          }
        },
        "type": "object",
        "required": [
          "logout_url"
        ],
        "title": "LogoutData"
      },
      "LogoutResponse": {
        "properties": {
          "data": {
            "$ref": "#/components/schemas/LogoutData"
          }
        },
        "type": "object",
        "required": [
          "data"
        ],
        "title": "LogoutResponse"
      },
      "SessionAccount": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "kind": {
            "type": "string",
            "enum": [
              "guest",
              "verified"
            ],
            "title": "Kind"
          },
          "email": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Email"
          },
          "player": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SessionPlayer"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "id",
          "kind",
          "email",
          "player"
        ],
        "title": "SessionAccount"
      },
      "SessionData": {
        "properties": {
          "account": {
            "$ref": "#/components/schemas/SessionAccount"
          }
        },
        "type": "object",
        "required": [
          "account"
        ],
        "title": "SessionData"
      },
      "SessionPlayer": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "display_name": {
            "type": "string",
            "title": "Display Name"
          }
        },
        "type": "object",
        "required": [
          "id",
          "display_name"
        ],
        "title": "SessionPlayer"
      },
      "SessionResponse": {
        "properties": {
          "data": {
            "$ref": "#/components/schemas/SessionData"
          }
        },
        "type": "object",
        "required": [
          "data"
        ],
        "title": "SessionResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-fortymm_session"
      }
    }
  }
}
