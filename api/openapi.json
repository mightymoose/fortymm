{
  "openapi": "3.1.0",
  "info": {
    "title": "FortyMM API",
    "version": "0.1.0"
  },
  "paths": {
    "/v1/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Health",
        "description": "Check that the API can reach its database.",
        "operationId": "health",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/session": {
      "post": {
        "tags": [
          "session"
        ],
        "summary": "Start Session",
        "description": "Resume the visitor's session, or start a guest account and its session.\n\nA valid session gets a later expiry and a fresh cookie. With no cookie, or\na cookie for an expired, unknown or adopted session, the visitor gets a\nnew guest account. The API deletes the session that cookie named. A\nclient network can start 30 guest accounts a minute. Past that, the API\nanswers 429.\n\nThe account's player is the one it plays as. Every account has one. A\nnew player gets a default display name, such as `excited egret 387`. A\nverified account has its email.",
        "operationId": "start_session",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionResponse"
                }
              }
            }
          },
          "429": {
            "description": "The client's network started too many guest accounts. Retry-After gives the seconds until it can start more."
          }
        },
        "security": [
          {
            "session": []
          }
        ]
      }
    },
    "/v1/auth/login": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "Login",
        "description": "Send the visitor to the identity provider's sign-in page.\n\nA request with no valid session gets no guest account. It gets a login\ncookie instead, which the callback checks. After sign-in, the callback\nsends the visitor to `return_to`. It must be a path\non this site, or the callback uses `/`.",
        "operationId": "login",
        "security": [
          {
            "session": []
          }
        ],
        "parameters": [
          {
            "name": "return_to",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Return To"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "A redirect"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/callback": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "Callback",
        "description": "Finish a sign-in, then send the visitor back to its `return_to`.\n\nA successful sign-in adds `signed_in=1` to that path's query. A failed\nsign-in adds `sign_in_error` instead: `cancelled`, `email_not_verified`,\n`expired` or `failed`. A callback whose `state` matches no login attempt,\nsuch as a replay, goes to `/`.",
        "operationId": "callback",
        "security": [
          {
            "session": []
          }
        ],
        "parameters": [
          {
            "name": "state",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "State"
            }
          },
          {
            "name": "code",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Code"
            }
          },
          {
            "name": "error",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Error"
            }
          },
          {
            "name": "__Host-fortymm_login",
            "in": "cookie",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "  Host-Fortymm Login"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "A redirect"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/logout": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Logout",
        "description": "End the visitor's session and expire its cookie.\n\n`logout_url` is the identity provider's logout page. The client follows\nit, so the provider's own session ends too. The provider then sends the\nbrowser to `/signed-out`, which starts no session. `/` would start a new\nguest account, and it wouldn't look like a sign-out.",
        "operationId": "logout",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LogoutResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "session": []
          }
        ]
      }
    },
    "/v1/account/players": {
      "get": {
        "tags": [
          "players"
        ],
        "summary": "Account Players",
        "description": "List the players the account manages, its own player first. A merged\nplayer isn't listed.\n\n`open_question` is true for a player that a sign-in brought to the\naccount, until the account answers \"Is this you?\" for it.",
        "operationId": "account_players",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountPlayersResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "session": []
          }
        ]
      }
    },
    "/v1/account/players/{player_id}/answer": {
      "post": {
        "tags": [
          "players"
        ],
        "summary": "Answer Question",
        "description": "Answer \"Is this you?\" for one player, and list the account's players\nafter it.\n\n`yes` makes it the account's own player. If the account already has one,\nthe two players merge. The player created first survives, and the other\nleaves the list. `no` keeps it as a player the account manages. `not_mine` takes\nit off the account. The player stays, with no manager. Every answer\ncloses the question. A second `yes` or `no` changes nothing, and a second\n`not_mine` answers 409.",
        "operationId": "answer_question",
        "security": [
          {
            "session": []
          }
        ],
        "parameters": [
          {
            "name": "player_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Player Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AnswerRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountPlayersResponse"
                }
              }
            }
          },
          "404": {
            "description": "The account doesn't manage the player"
          },
          "409": {
            "description": "The answer is `not_mine` and the question was already answered"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AccountPlayer": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "display_name": {
            "type": "string",
            "title": "Display Name"
          },
          "relationship": {
            "type": "string",
            "enum": [
              "self",
              "managed"
            ],
            "title": "Relationship"
          },
          "open_question": {
            "type": "boolean",
            "title": "Open Question"
          }
        },
        "type": "object",
        "required": [
          "id",
          "display_name",
          "relationship",
          "open_question"
        ],
        "title": "AccountPlayer"
      },
      "AccountPlayersResponse": {
        "properties": {
          "data": {
            "items": {
              "$ref": "#/components/schemas/AccountPlayer"
            },
            "type": "array",
            "title": "Data"
          }
        },
        "type": "object",
        "required": [
          "data"
        ],
        "title": "AccountPlayersResponse"
      },
      "Answer": {
        "type": "string",
        "enum": [
          "yes",
          "no",
          "not_mine"
        ],
        "title": "Answer"
      },
      "AnswerRequest": {
        "properties": {
          "answer": {
            "$ref": "#/components/schemas/Answer"
          }
        },
        "type": "object",
        "required": [
          "answer"
        ],
        "title": "AnswerRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "data": {
            "$ref": "#/components/schemas/HealthStatus"
          }
        },
        "type": "object",
        "required": [
          "data"
        ],
        "title": "HealthResponse"
      },
      "HealthStatus": {
        "properties": {
          "database": {
            "type": "string",
            "const": "ok",
            "title": "Database"
          }
        },
        "type": "object",
        "required": [
          "database"
        ],
        "title": "HealthStatus"
      },
      "LogoutData": {
        "properties": {
          "logout_url": {
            "type": "string",
            "title": "Logout Url"
          }
        },
        "type": "object",
        "required": [
          "logout_url"
        ],
        "title": "LogoutData"
      },
      "LogoutResponse": {
        "properties": {
          "data": {
            "$ref": "#/components/schemas/LogoutData"
          }
        },
        "type": "object",
        "required": [
          "data"
        ],
        "title": "LogoutResponse"
      },
      "SessionAccount": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "kind": {
            "type": "string",
            "enum": [
              "guest",
              "verified"
            ],
            "title": "Kind"
          },
          "email": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Email"
          },
          "player": {
            "$ref": "#/components/schemas/SessionPlayer"
          }
        },
        "type": "object",
        "required": [
          "id",
          "kind",
          "email",
          "player"
        ],
        "title": "SessionAccount"
      },
      "SessionData": {
        "properties": {
          "account": {
            "$ref": "#/components/schemas/SessionAccount"
          }
        },
        "type": "object",
        "required": [
          "account"
        ],
        "title": "SessionData"
      },
      "SessionPlayer": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "display_name": {
            "type": "string",
            "title": "Display Name"
          }
        },
        "type": "object",
        "required": [
          "id",
          "display_name"
        ],
        "title": "SessionPlayer"
      },
      "SessionResponse": {
        "properties": {
          "data": {
            "$ref": "#/components/schemas/SessionData"
          }
        },
        "type": "object",
        "required": [
          "data"
        ],
        "title": "SessionResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-fortymm_session"
      }
    }
  }
}
