{
  "openapi": "3.1.0",
  "info": {
    "title": "FortyMM API",
    "version": "0.1.0"
  },
  "paths": {
    "/v1/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Health",
        "description": "Check that the API can reach its database.",
        "operationId": "health",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/session": {
      "post": {
        "tags": [
          "session"
        ],
        "summary": "Start Session",
        "description": "Resume the visitor's session, or start a guest account and its session.\n\nA valid session gets a later expiry and a fresh cookie. With no cookie, or\na cookie for an expired, unknown or adopted session, the visitor gets a\nnew guest account. The API deletes the session that cookie named. A\nclient network can start 30 guest accounts a minute. Past that, the API\nanswers 429.\n\nThe account's player is the one it plays as. A new guest account's player\ngets a default display name, such as `excited egret 387`.",
        "operationId": "start_session",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionResponse"
                }
              }
            }
          },
          "429": {
            "description": "The client's network started too many guest accounts. Retry-After gives the seconds until it can start more."
          }
        },
        "security": [
          {
            "session": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "HealthResponse": {
        "properties": {
          "data": {
            "$ref": "#/components/schemas/HealthStatus"
          }
        },
        "type": "object",
        "required": [
          "data"
        ],
        "title": "HealthResponse"
      },
      "HealthStatus": {
        "properties": {
          "database": {
            "type": "string",
            "const": "ok",
            "title": "Database"
          }
        },
        "type": "object",
        "required": [
          "database"
        ],
        "title": "HealthStatus"
      },
      "SessionAccount": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "kind": {
            "type": "string",
            "enum": [
              "guest",
              "verified"
            ],
            "title": "Kind"
          },
          "player": {
            "$ref": "#/components/schemas/SessionPlayer"
          }
        },
        "type": "object",
        "required": [
          "id",
          "kind",
          "player"
        ],
        "title": "SessionAccount"
      },
      "SessionData": {
        "properties": {
          "account": {
            "$ref": "#/components/schemas/SessionAccount"
          }
        },
        "type": "object",
        "required": [
          "account"
        ],
        "title": "SessionData"
      },
      "SessionPlayer": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "display_name": {
            "type": "string",
            "title": "Display Name"
          }
        },
        "type": "object",
        "required": [
          "id",
          "display_name"
        ],
        "title": "SessionPlayer"
      },
      "SessionResponse": {
        "properties": {
          "data": {
            "$ref": "#/components/schemas/SessionData"
          }
        },
        "type": "object",
        "required": [
          "data"
        ],
        "title": "SessionResponse"
      }
    },
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-fortymm_session"
      }
    }
  }
}
