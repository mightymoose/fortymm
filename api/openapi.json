{
  "openapi": "3.1.0",
  "info": {
    "title": "FortyMM API",
    "version": "0.1.0"
  },
  "paths": {
    "/v1/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Health",
        "description": "Check that the API can reach its database.",
        "operationId": "health",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/session": {
      "post": {
        "tags": [
          "session"
        ],
        "summary": "Start Session",
        "description": "Resume the visitor's session, or start a guest account and its session.\n\nA valid session gets a later expiry and a fresh cookie. With no cookie, or\na cookie for an expired, unknown or adopted session, the visitor gets a\nnew guest account. The API deletes the session that cookie named. A\nclient network can start 30 guest accounts a minute. Past that, the API\nanswers 429.\n\nThe account's player is the one it plays as. Every account has one. A\nnew player gets a default display name, such as `excited egret 387`. A\nverified account has its email.",
        "operationId": "start_session",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionResponse"
                }
              }
            }
          },
          "429": {
            "description": "The client's network started too many guest accounts. Retry-After gives the seconds until it can start more.",
            "headers": {
              "Retry-After": {
                "description": "The seconds until the network can start more",
                "schema": {
                  "type": "integer"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorsResponse"
                }
              }
            }
          },
          "415": {
            "description": "The request's Content-Type isn't application/json",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorsResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "session": []
          }
        ]
      }
    },
    "/v1/auth/login": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "Login",
        "description": "Send the visitor to the identity provider's sign-in page.\n\nA request with no valid session gets no guest account. It gets a login\ncookie instead, which the callback checks. After sign-in, the callback\nsends the visitor to `return_to`. It must be a path\non this site, or the callback uses `/`.",
        "operationId": "login",
        "security": [
          {
            "session": []
          }
        ],
        "parameters": [
          {
            "name": "return_to",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Return To"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "A redirect"
          },
          "429": {
            "description": "The client's network started too many guest accounts. Retry-After gives the seconds until it can start more.",
            "headers": {
              "Retry-After": {
                "description": "The seconds until the network can start more",
                "schema": {
                  "type": "integer"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorsResponse"
                }
              }
            }
          },
          "503": {
            "description": "The API has no identity provider configured",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorsResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/callback": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "Callback",
        "description": "Finish a sign-in, then send the visitor back to its `return_to`.\n\nA successful sign-in adds `signed_in=1` to that path's query. A failed\nsign-in adds `sign_in_error` instead: `cancelled`, `email_not_verified`,\n`expired` or `failed`. A callback whose `state` matches no login attempt,\nsuch as a replay, goes to `/`.",
        "operationId": "callback",
        "security": [
          {
            "session": []
          }
        ],
        "parameters": [
          {
            "name": "state",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "State"
            }
          },
          {
            "name": "code",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Code"
            }
          },
          {
            "name": "error",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Error"
            }
          },
          {
            "name": "__Host-fortymm_login",
            "in": "cookie",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "  Host-Fortymm Login"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "A redirect"
          },
          "503": {
            "description": "The API has no identity provider configured",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorsResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/app-login": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "App Login",
        "description": "Start a sign-in from the native app.\n\nThe app opens `authorize_url` in a browser of its own. That browser has\nnone of the app's cookies, so the provider sends it to `app-callback`,\nwhich hands the query back to the app, and the app finishes the sign-in\nwith `app-finish`. Like `login`, a request with no valid session gets no\nguest account, but a login cookie that `app-finish` checks.\n`authorize_url` can be relative to the API's origin.",
        "operationId": "app_login",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AppLoginResponse"
                }
              }
            }
          },
          "429": {
            "description": "The client's network started too many guest accounts. Retry-After gives the seconds until it can start more.",
            "headers": {
              "Retry-After": {
                "description": "The seconds until the network can start more",
                "schema": {
                  "type": "integer"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorsResponse"
                }
              }
            }
          },
          "415": {
            "description": "The request's Content-Type isn't application/json",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorsResponse"
                }
              }
            }
          },
          "503": {
            "description": "The API has no identity provider configured",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorsResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "session": []
          }
        ]
      }
    },
    "/v1/auth/app-callback": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "App Callback",
        "description": "Send the provider's redirect on to the native app.\n\nIt answers 302 to `fortymm://sign-in` with this request's query, which\nthe app passes to `app-finish`. Another app that claims the scheme gets\nnothing it can use, because finishing needs the app's session or login\ncookie.",
        "operationId": "app_callback",
        "responses": {
          "302": {
            "description": "A redirect"
          }
        }
      }
    },
    "/v1/auth/app-finish": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "App Finish",
        "description": "Finish a sign-in that `app-login` started, with the query that\n`app-callback` handed to the app.\n\n`outcome` is `signed_in`, or why the sign-in failed: `cancelled`,\n`email_not_verified`, `expired` or `failed`. A sign-in sets a new session\ncookie. A `state` that matches no login attempt, such as a replay, is\n`expired`. A failed sign-in changes no account.",
        "operationId": "app_finish",
        "security": [
          {
            "session": []
          }
        ],
        "parameters": [
          {
            "name": "__Host-fortymm_login",
            "in": "cookie",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "  Host-Fortymm Login"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AppFinishRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AppFinishResponse"
                }
              }
            }
          },
          "415": {
            "description": "The request's Content-Type isn't application/json",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorsResponse"
                }
              }
            }
          },
          "503": {
            "description": "The API has no identity provider configured",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorsResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/logout": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Logout",
        "description": "End the visitor's session and expire its cookie.\n\n`logout_url` is the identity provider's logout page. The client follows\nit, so the provider's own session ends too. The provider then sends the\nbrowser to `/signed-out`, which starts no session. `/` would start a new\nguest account, and it wouldn't look like a sign-out.",
        "operationId": "logout",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LogoutResponse"
                }
              }
            }
          },
          "415": {
            "description": "The request's Content-Type isn't application/json",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorsResponse"
                }
              }
            }
          },
          "503": {
            "description": "The API has no identity provider configured",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorsResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "session": []
          }
        ]
      }
    },
    "/v1/account/players": {
      "get": {
        "tags": [
          "players"
        ],
        "summary": "Account Players",
        "description": "List the players the account manages, its own player first. A merged\nplayer isn't listed.\n\n`open_question` is true for a player that a sign-in brought to the\naccount, until the account answers \"Is this you?\" for it.\n`match_count` counts the player's matches, and `recent_matches` holds\nits latest ones, newest first.",
        "operationId": "account_players",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountPlayersResponse"
                }
              }
            }
          },
          "401": {
            "description": "The request has no valid session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorsResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "session": []
          }
        ]
      }
    },
    "/v1/account/players/{player_id}/answer": {
      "post": {
        "tags": [
          "players"
        ],
        "summary": "Answer Question",
        "description": "Answer \"Is this you?\" for one player. `data` lists the account's\nplayers after the answer, and `meta.outcome` says what the answer did.\n\n`yes` makes it the account's own player, with outcome `self`. If the\naccount already has one, the two players merge, with outcome `merged`.\n`no` keeps it as a player the account manages, with outcome `managed`.\n`not_mine` takes it off the account, with outcome `removed`. The player\nstays, with no manager. `same_as` merges it with the `managed` player\nthat `player_id` names, with outcome `merged`. That player's question\nmust be closed, because the merge would close it with no answer.\n\nIn a merge, the player created first survives, and the other leaves the\nlist. `meta.survivor` and `meta.merged` name them. Every answer closes\nthe question. A second answer changes nothing, with outcome\n`already_answered`, but a second `not_mine` answers 409.",
        "operationId": "answer_question",
        "security": [
          {
            "session": []
          }
        ],
        "parameters": [
          {
            "name": "player_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Player Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AnswerRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnswerResponse"
                }
              }
            }
          },
          "401": {
            "description": "The request has no valid session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorsResponse"
                }
              }
            }
          },
          "404": {
            "description": "The account doesn't manage the player, or `player_id` isn't a `managed` player of the account with a closed question",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorsResponse"
                }
              }
            }
          },
          "409": {
            "description": "The answer is `not_mine` and the question was already answered",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorsResponse"
                }
              }
            }
          },
          "415": {
            "description": "The request's Content-Type isn't application/json",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorsResponse"
                }
              }
            }
          },
          "422": {
            "description": "The body is invalid, or `player_id` is missing with `same_as` or set with another answer. If `player_id` is the answered player, the body is in the `errors` shape instead",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AccountPlayer": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "display_name": {
            "type": "string",
            "title": "Display Name"
          },
          "relationship": {
            "type": "string",
            "enum": [
              "self",
              "managed"
            ],
            "title": "Relationship"
          },
          "open_question": {
            "type": "boolean",
            "title": "Open Question"
          },
          "match_count": {
            "type": "integer",
            "title": "Match Count"
          },
          "recent_matches": {
            "items": {
              "$ref": "#/components/schemas/RecentMatch"
            },
            "type": "array",
            "title": "Recent Matches"
          }
        },
        "type": "object",
        "required": [
          "id",
          "display_name",
          "relationship",
          "open_question",
          "match_count",
          "recent_matches"
        ],
        "title": "AccountPlayer"
      },
      "AccountPlayersResponse": {
        "properties": {
          "data": {
            "items": {
              "$ref": "#/components/schemas/AccountPlayer"
            },
            "type": "array",
            "title": "Data"
          }
        },
        "type": "object",
        "required": [
          "data"
        ],
        "title": "AccountPlayersResponse"
      },
      "Answer": {
        "type": "string",
        "enum": [
          "yes",
          "no",
          "not_mine",
          "same_as"
        ],
        "title": "Answer"
      },
      "AnswerRequest": {
        "properties": {
          "answer": {
            "$ref": "#/components/schemas/Answer"
          },
          "player_id": {
            "format": "uuid",
            "type": [
              "string",
              "null"
            ],
            "title": "Player Id"
          }
        },
        "type": "object",
        "required": [
          "answer"
        ],
        "title": "AnswerRequest"
      },
      "AnswerResponse": {
        "properties": {
          "data": {
            "items": {
              "$ref": "#/components/schemas/AccountPlayer"
            },
            "type": "array",
            "title": "Data"
          },
          "meta": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/MergedOutcome"
              },
              {
                "$ref": "#/components/schemas/SettledOutcome"
              }
            ],
            "title": "Meta",
            "discriminator": {
              "propertyName": "outcome",
              "mapping": {
                "already_answered": "#/components/schemas/SettledOutcome",
                "managed": "#/components/schemas/SettledOutcome",
                "merged": "#/components/schemas/MergedOutcome",
                "removed": "#/components/schemas/SettledOutcome",
                "self": "#/components/schemas/SettledOutcome"
              }
            }
          }
        },
        "type": "object",
        "required": [
          "data",
          "meta"
        ],
        "title": "AnswerResponse"
      },
      "AppFinishData": {
        "properties": {
          "outcome": {
            "$ref": "#/components/schemas/AppSignInOutcome"
          }
        },
        "type": "object",
        "required": [
          "outcome"
        ],
        "title": "AppFinishData"
      },
      "AppFinishRequest": {
        "properties": {
          "state": {
            "type": [
              "string",
              "null"
            ],
            "title": "State"
          },
          "code": {
            "type": [
              "string",
              "null"
            ],
            "title": "Code"
          },
          "error": {
            "type": [
              "string",
              "null"
            ],
            "title": "Error"
          }
        },
        "type": "object",
        "title": "AppFinishRequest"
      },
      "AppFinishResponse": {
        "properties": {
          "data": {
            "$ref": "#/components/schemas/AppFinishData"
          }
        },
        "type": "object",
        "required": [
          "data"
        ],
        "title": "AppFinishResponse"
      },
      "AppLoginData": {
        "properties": {
          "authorize_url": {
            "type": "string",
            "title": "Authorize Url"
          }
        },
        "type": "object",
        "required": [
          "authorize_url"
        ],
        "title": "AppLoginData"
      },
      "AppLoginResponse": {
        "properties": {
          "data": {
            "$ref": "#/components/schemas/AppLoginData"
          }
        },
        "type": "object",
        "required": [
          "data"
        ],
        "title": "AppLoginResponse"
      },
      "AppSignInOutcome": {
        "type": "string",
        "enum": [
          "signed_in",
          "cancelled",
          "email_not_verified",
          "expired",
          "failed"
        ],
        "title": "AppSignInOutcome"
      },
      "Error": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "title": {
            "type": "string",
            "title": "Title"
          }
        },
        "type": "object",
        "required": [
          "status",
          "title"
        ],
        "title": "Error"
      },
      "ErrorsResponse": {
        "properties": {
          "errors": {
            "items": {
              "$ref": "#/components/schemas/Error"
            },
            "type": "array",
            "title": "Errors"
          }
        },
        "type": "object",
        "required": [
          "errors"
        ],
        "title": "ErrorsResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "data": {
            "$ref": "#/components/schemas/HealthStatus"
          }
        },
        "type": "object",
        "required": [
          "data"
        ],
        "title": "HealthResponse"
      },
      "HealthStatus": {
        "properties": {
          "database": {
            "type": "string",
            "const": "ok",
            "title": "Database"
          }
        },
        "type": "object",
        "required": [
          "database"
        ],
        "title": "HealthStatus"
      },
      "LogoutData": {
        "properties": {
          "logout_url": {
            "type": "string",
            "title": "Logout Url"
          }
        },
        "type": "object",
        "required": [
          "logout_url"
        ],
        "title": "LogoutData"
      },
      "LogoutResponse": {
        "properties": {
          "data": {
            "$ref": "#/components/schemas/LogoutData"
          }
        },
        "type": "object",
        "required": [
          "data"
        ],
        "title": "LogoutResponse"
      },
      "MergedOutcome": {
        "properties": {
          "outcome": {
            "type": "string",
            "const": "merged",
            "title": "Outcome"
          },
          "survivor": {
            "type": "string",
            "format": "uuid",
            "title": "Survivor"
          },
          "merged": {
            "type": "string",
            "format": "uuid",
            "title": "Merged"
          }
        },
        "type": "object",
        "required": [
          "outcome",
          "survivor",
          "merged"
        ],
        "title": "MergedOutcome"
      },
      "RecentMatch": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
