#!/usr/bin/env bash
# Install the tools pinned in mise.container.toml (cached in the mise volume),
# then run the requested command with them on PATH.
set -euo pipefail

# Every container shares the mise volume. Without the lock, two installs can run
# at once, and one can finish while a tool the other is writing is still missing.
flock /mise/.install.lock /app/bin/mise install --quiet
# The compose healthcheck reports the container ready once this exists.
touch /tmp/tools-installed
exec /app/bin/mise exec -- "$@"
