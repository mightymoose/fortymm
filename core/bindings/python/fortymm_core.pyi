# Type stub for the core's Python module (src/lib.rs), for mypy in the api.
# Keep it in step with src/lib.rs. Only what the module defines is listed;
# check_vectors.py fails if a name is missing here or extra.
#
# The getters (sides, terms, repeats_player, creator, introduced_key,
# match_id, extra_player_id) report what the bytes say, not that the record
# counts: verify() is a separate call. A record this library did not
# interpret gives None from each; it still has its signer.

FORMAT_VERSION: int

class Malformed(ValueError): ...
class Damaged(ValueError): ...

class Record:
    @staticmethod
    def decode(data: bytes) -> Record: ...
    @staticmethod
    def from_parts(body: bytes, signature: bytes) -> Record: ...
    def to_bytes(self) -> bytes: ...
    @property
    def body(self) -> bytes: ...
    @property
    def signature(self) -> bytes: ...
    @property
    def signer(self) -> bytes: ...
    @property
    def format_version(self) -> int: ...
    @property
    def kind(self) -> int: ...
    @property
    def kind_name(self) -> str | None: ...
    @property
    def interpreted(self) -> bool: ...
    @property
    def environment(self) -> int: ...
    @property
    def sides(self) -> list[list[bytes]] | None: ...
    @property
    def terms(self) -> bytes | None: ...
    @property
    def repeats_player(self) -> bool | None: ...
    @property
    def creator(self) -> bytes | None: ...
    @property
    def introduced_key(self) -> bytes | None: ...
    def id(self) -> bytes: ...
    def verify(self) -> bool: ...
    def outcome_id(self) -> bytes | None: ...
    def match_id(self) -> bytes | None: ...
    def extra_player_id(self) -> bytes | None: ...
    def signer_account_id(self) -> bytes: ...
    def signer_own_player_id(self) -> bytes: ...

class Parcel:
    def __init__(self, environment: int, records: list[Record]) -> None: ...
    @staticmethod
    def parse(text: str) -> Parcel: ...
    @staticmethod
    def from_binary(data: bytes) -> Parcel: ...
    @property
    def environment(self) -> int: ...
    @property
    def records(self) -> list[Record]: ...
    def to_binary(self) -> bytes: ...
    def text(self) -> str: ...
    def link(self, host: str) -> str: ...
    def split(self, max_chars: int) -> list[Parcel]: ...

def signature_from_der(der: bytes) -> bytes: ...
def signature_from_raw(raw: bytes) -> bytes: ...
def account_id(public_key: bytes) -> bytes: ...
def own_player_id(public_key: bytes) -> bytes: ...
def checksum(data: bytes) -> int: ...
def username(player_id: bytes, suffix_length: int) -> str: ...
