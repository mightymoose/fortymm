# Type stub for the core's Python module (src/lib.rs), for mypy in the api.
# Keep it in step with src/lib.rs. Only what the module defines is listed;
# check_vectors.py fails if a name is missing here or extra.
#
# The getters (sides, terms, repeats_player, creator, introduced_key,
# match_id, extra_player_id) report what the bytes say, not that the record
# counts: verify() is a separate call. A record this library did not
# interpret gives None from each; it still has its signer. One of a match's
# sides may be an empty list: an anonymous side.

FORMAT_VERSION: int

class Malformed(ValueError): ...
class Damaged(ValueError): ...

class Record:
    @staticmethod
    def decode(data: bytes) -> Record: ...
    @staticmethod
    def from_parts(body: bytes, signature: bytes) -> Record: ...
    def to_bytes(self) -> bytes: ...
    @property
    def body(self) -> bytes: ...
    @property
    def signature(self) -> bytes: ...
    @property
    def signer(self) -> bytes: ...
    @property
    def format_version(self) -> int: ...
    @property
    def kind(self) -> int: ...
    @property
    def kind_name(self) -> str | None: ...
    @property
    def interpreted(self) -> bool: ...
    @property
    def environment(self) -> int: ...
    @property
    def sides(self) -> list[list[bytes]] | None: ...
    @property
    def terms(self) -> bytes | None: ...
    @property
    def repeats_player(self) -> bool | None: ...
    @property
    def creator(self) -> bytes | None: ...
    @property
    def introduced_key(self) -> bytes | None: ...
    # What a `score` record says; None for every other record. scored_match
    # is the match the score is about (match_id() is a `match` record's own).
    @property
    def scored_match(self) -> bytes | None: ...
    @property
    def slot(self) -> int | None: ...
    @property
    def value(self) -> bytes | None: ...
    @property
    def replaces(self) -> list[bytes] | None: ...
    def id(self) -> bytes: ...
    def verify(self) -> bool: ...
    def outcome_id(self) -> bytes | None: ...
    def match_id(self) -> bytes | None: ...
    def extra_player_id(self) -> bytes | None: ...
    def signer_account_id(self) -> bytes: ...
    def signer_own_player_id(self) -> bytes: ...

class Parcel:
    def __init__(self, environment: int, records: list[Record]) -> None: ...
    @staticmethod
    def parse(text: str) -> Parcel: ...
    @staticmethod
    def from_binary(data: bytes) -> Parcel: ...
    @property
    def environment(self) -> int: ...
    @property
    def records(self) -> list[Record]: ...
    def to_binary(self) -> bytes: ...
    def text(self) -> str: ...
    def link(self, host: str) -> str: ...
    def split(self, max_chars: int) -> list[Parcel]: ...

def signature_from_der(der: bytes) -> bytes: ...
def signature_from_raw(raw: bytes) -> bytes: ...
def account_id(public_key: bytes) -> bytes: ...
def own_player_id(public_key: bytes) -> bytes: ...
def checksum(data: bytes) -> int: ...
def hello_body(environment: int, public_key: bytes, random: bytes, clock: int | None = None) -> bytes: ...
def username(player_id: bytes, suffix_length: int) -> str: ...

# The product layouts: the bytes a match record carries as its terms and a
# score record as its value. best_of is an odd number, 1 or more; terms_bytes
# raises Malformed for any other. A score is the two sides' points, first side
# first, or None for a cleared game. Reading gives None for bytes of another
# layout version and for damaged bytes.

class Terms:
    @property
    def best_of(self) -> int: ...
    @property
    def rated(self) -> bool: ...

class ScoreValue:
    @property
    def score(self) -> tuple[int, int] | None: ...

def terms_bytes(best_of: int, rated: bool) -> bytes: ...
def read_terms(data: bytes) -> Terms | None: ...
def score_value(score: tuple[int, int] | None) -> bytes: ...
def read_score_value(data: bytes) -> ScoreValue | None: ...

# Making a `player`, a `match` and a `score`: each body is signed and
# assembled as a hello's is. An id is 32 bytes; terms and value are bytes the
# core carries and does not read. A match's side is a list of player ids, and
# one side may be empty, an anonymous side, never both (two empty sides raise
# Malformed). A match with an anonymous side can't be rated: terms that read
# as rated raise Malformed.
def player_body(environment: int, public_key: bytes, random: bytes, clock: int | None = None) -> bytes: ...
def match_body(
    environment: int,
    public_key: bytes,
    random: bytes,
    sides: list[list[bytes]],
    terms: bytes,
    clock: int | None = None,
) -> bytes: ...
def score_body(
    environment: int,
    public_key: bytes,
    random: bytes,
    match_id: bytes,
    slot: int,
    value: bytes,
    replaces: list[bytes],
    clock: int | None = None,
) -> bytes: ...

# A match's state, derived from the set of records about it (core/FORMAT.md,
# section 16): any order, repeats allowed. Score records of other matches, and
# records of other kinds, are ignored. None when there is no match record, or a
# match record of another match too.
class MatchState:
    @property
    def match_id(self) -> bytes: ...
    @property
    def creator(self) -> bytes: ...
    @property
    def sides(self) -> list[list[bytes]]: ...
    @property
    def terms(self) -> Terms | None: ...
    @property
    def games(self) -> list[tuple[int, int] | None]: ...
    @property
    def current(self) -> list[list[bytes]]: ...

# A match's state (core/FORMAT.md, section 16): any order, repeats allowed.
# Score records of other matches, and records of other kinds, are ignored.
# None when there is no match record, or a match record of another match too:
# pass only this match's records.
def match_state(records: list[Record]) -> MatchState | None: ...
