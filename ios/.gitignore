# Xcode user state (per-developer, never commit)
xcuserdata/
*.xcuserstate
*.xcuserdatad/

# Build artifacts
build/
DerivedData/
*.ipa
*.dSYM.zip
*.dSYM

# Swift Package Manager — Package.resolved is committed (pins dependency
# versions for reproducible builds), only the local build cache is ignored.
.build/
.swiftpm/

# CocoaPods / Carthage (not used yet, but pre-empt)
Pods/
Carthage/Build/

# fastlane
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/**/*.png
fastlane/test_output/
*.mobileprovision

# fastlane secrets — never commit
.env
.env.local
fastlane/*.p8
AuthKey_*.p8

# Bundler (gems installed locally via `bundle install --path vendor/bundle`)
.bundle/
vendor/bundle/
