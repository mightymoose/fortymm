<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Universal Links. The API emails real https links to the web app
	  (api/app/email.py): the magic-link sign-in (/login/verifying?token=…) and
	  the email confirmation (/confirm-email?token=…). With this association,
	  tapping one on the phone opens FortyMM instead of Safari — see
	  Navigation/DeepLink.swift for the path matching and RootView for routing.

	  The matching apple-app-site-association file is hosted at the domain:
	  web-client/public/.well-known/apple-app-site-association.

	  The app currently ships pointed at uat.fortymm.com; add a prod
	  `applinks:fortymm.com` entry here (and its AASA) when prod goes live.
	-->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:uat.fortymm.com</string>
	</array>
	<!--
	  Push Notifications. "development" covers debug/device runs; production
	  builds are handled by the provisioning profile (Xcode overwrites this
	  value during Archive). Enable the capability on the App ID in the Apple
	  Developer portal before building: Certificates, IDs & Profiles →
	  Identifiers → com.fortymm.ios-client → Push Notifications.
	-->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
