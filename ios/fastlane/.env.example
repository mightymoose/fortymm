# App Store Connect API key — used by the `beta` lane.
# Create a key at https://appstoreconnect.apple.com/access/integrations/api
# Copy this file to `.env` (gitignored) and fill in your values, or export
# these in CI as secrets.

ASC_KEY_ID=XXXXXXXXXX
ASC_ISSUER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Path to the downloaded .p8 private key file (keep it out of git).
ASC_KEY_PATH=./fastlane/AuthKey_XXXXXXXXXX.p8
