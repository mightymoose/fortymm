default_platform(:ios)

PROJECT = "Fortymm.xcodeproj"
SCHEME  = "Fortymm"

platform :ios do
  desc "Build the app for the simulator (no signing) — fast CI/local sanity check"
  lane :build do
    sh(
      "xcodebuild",
      "-project", "../#{PROJECT}",
      "-scheme", SCHEME,
      "-destination", "generic/platform=iOS Simulator",
      "-configuration", "Debug",
      "CODE_SIGNING_ALLOWED=NO",
      "build"
    )
  end

  desc "Build a signed release and upload to TestFlight"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: ENV.fetch("ASC_KEY_PATH")
    )

    # Bump the build number to one above the latest on TestFlight so every
    # upload is unique without hand-editing the project. app_identifier is
    # read from the Appfile.
    latest = latest_testflight_build_number(
      api_key: api_key,
      initial_build_number: 0
    )
    increment_build_number(
      xcodeproj: PROJECT,
      build_number: latest + 1
    )

    build_app(
      project: PROJECT,
      scheme: SCHEME,
      configuration: "Release",
      export_method: "app-store",
      # Let Xcode's automatic signing pick the distribution cert/profile.
      xcargs: "-allowProvisioningUpdates"
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
