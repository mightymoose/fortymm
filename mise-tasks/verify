#!/usr/bin/env bash
#MISE description="Start the dev servers, then run lint, typecheck and tests for the web client and api, the e2e tests and journeys against the servers, and the Dafny requirements"
# Host-side. Runs every check even if one fails, then exits non-zero if any did.
# Leaves the dev servers as it found them: stops them at the end only if it started them.
set -uo pipefail
cd "$MISE_PROJECT_ROOT"

# Only the service's own container counts (the one dev starts, reachable as `web-client`), not
# one-off `run` containers such as web-client:dev's (named <project>-web-client-run-<id>).
if ! docker compose ps --status running --format '{{.Name}}' web-client | grep -qv -- '-run-'; then
  trap 'docker compose stop api web-client web-client-nginx design-system >/dev/null 2>&1 || true' EXIT
  ./bin/mise run dev --detach || exit 1
fi

failed=()
check() {
  local name=$1; shift
  echo "==> $name" >&2
  "$@" || failed+=("$name")
}
# One throwaway container per check, on the compose network, using the image dev just built.
in_web_client() { docker compose run --rm --no-deps "$@"; }
in_api() { docker compose run --rm --no-deps api "$@"; }
in_core() { docker compose run --rm --build core "$@"; }
# Not one of the dev servers, so dev doesn't build it: build it here.
in_journeys() { docker compose run --rm --no-deps --build journeys "$@"; }
# The journeys run against the built web client: rebuild it first, in case dev was already running.
run_journeys() {
  docker compose up --detach --wait --build web-client-nginx >&2 && in_journeys npx playwright test
}
# oasdiff: does api/openapi.json break clients of the spec on main, as of where this branch split off?
api_breaking() {
  local base
  base=$(mktemp)
  if ! git show "$(git merge-base HEAD main):api/openapi.json" > "$base" 2>/dev/null; then
    echo "main has no api/openapi.json yet; nothing to compare against" >&2
    rm -f "$base"
    return 0
  fi
  docker compose run --rm --no-deps -v "$base:/tmp/base.json:ro" api \
    oasdiff breaking /tmp/base.json openapi.json --fail-on ERR
  local status=$?
  rm -f "$base"
  return $status
}

check lint      in_web_client web-client npm run lint
check typecheck in_web_client web-client npm run typecheck
check unit      in_web_client web-client npm test
# Drift: the committed src/api/generated.ts must match what orval generates from api/openapi.json.
check api-client-drift in_web_client -e ORVAL_TARGET=/tmp/generated.ts web-client sh -c 'npx orval >/dev/null && diff -u src/api/generated.ts /tmp/generated.ts && echo "generated.ts is current" || { echo "src/api/generated.ts is stale: run ./bin/mise run web-client:api-client" >&2; exit 1; }'
# The tests reach the running dev server by its compose service name.
check e2e       in_web_client -e E2E_BASE_URL=http://web-client:5173 web-client npx playwright test
# The whole stack in a browser: web client, its /api proxy, the api, and the core on both sides.
check journeys-typecheck in_journeys npm run typecheck
check journeys  run_journeys
check api-lint      in_api ruff check
check api-format    in_api ruff format --check
check api-typecheck in_api mypy .
check api-test      in_api pytest
# Drift: the committed api/openapi.json must match what the app generates (./bin/mise run api:openapi).
check api-openapi-drift in_api sh -c 'python -m scripts.export_openapi | diff -u openapi.json - && echo "openapi.json is current" || { echo "openapi.json is stale: run ./bin/mise run api:openapi" >&2; exit 1; }'
check api-breaking  api_breaking
# The core itself. Its bindings are exercised by `unit` and `api-test`: dev builds them into the
# web-client and api images.
check core-lint     in_core cargo clippy --locked --workspace --all-targets -- -D warnings
check core-format   in_core cargo fmt --check
check core-test     in_core cargo test --locked --workspace
# The Dafny requirements in requirements/. Not a dev server, so dev doesn't build its image: build it here.
check requirements  docker compose run --rm --build check-requirements

if [ ${#failed[@]} -gt 0 ]; then
  echo "verify failed: ${failed[*]}" >&2
  exit 1
fi
echo "verify passed" >&2
