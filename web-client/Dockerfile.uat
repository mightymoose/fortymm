# Multi-stage build: produce a built bundle with node, then serve it
# as static assets from nginx. No Vite dev server, no HMR.
#
# Web client base URL falls back to window.location.origin (see
# src/api/client.ts), so no VITE_API_URL build arg is needed — host
# Caddy routes /v1/* to the api service on the same origin.

FROM node:26-alpine AS builder
WORKDIR /app

COPY package.json package-lock.json .npmrc ./
RUN npm ci

COPY . .
RUN npm run build

FROM nginx:1.27-alpine
COPY --from=builder /app/dist /usr/share/nginx/html
COPY nginx-uat.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
