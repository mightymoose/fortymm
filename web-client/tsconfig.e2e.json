{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.e2e.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["node", "vite/client"],
    "skipLibCheck": true,

    /* Bundler mode — the E2E suite imports application source files (relative
       paths and the `@/*` alias), so it resolves modules the same way the app
       project does. */
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "allowImportingTsExtensions": true,
    "noEmit": true,

    /* Nullability is the contract this gate exists to enforce (the Playwright
       transpiler does not check it). Other `strict` members stay off: this
       project must not silently tighten the application source it pulls in. */
    "strictNullChecks": true,

    "jsx": "react-jsx",

    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["playwright.config.ts", "e2e"]
}
