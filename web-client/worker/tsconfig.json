{
  "compilerOptions": {
    "target": "es2024",
    "lib": ["ES2024"],
    // Env and the Workers runtime's types, generated from wrangler.jsonc by
    // `wrangler types` (web-client:deploy-check runs it first).
    "types": ["./worker-configuration.d.ts"],
    "skipLibCheck": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"]
}
