// Cloudflare Workers: worker/index.ts forwards /api/* to the API on Cloud
// Run and serves everything else from the Vite build in dist/.
// Deployed by `mise run web-client:deploy` (CI does it on pushes to main).
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fortymm",
  "compatibility_date": "2026-10-20",
  "main": "./worker/index.ts",
  // API_ORIGIN (the Cloud Run URL) isn't set here: the deploy tasks pass it
  // with --var, since each Preview points at its own Cloud Run revision.
  // They pass WORKER_SECRET, the header the API requires, with --secrets-file.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Run the Worker before the assets for every path. It redirects
    // www.fortymm.com and fortymm.mightymoose.workers.dev to fortymm.com,
    // which it can't do for a path the assets answer first.
    "run_worker_first": true,
    // Serve index.html for paths with no matching file, so client-side
    // (TanStack Router) routes work on a direct load or refresh.
    "not_found_handling": "single-page-application"
  },
  // About 100 /api/* requests a minute per client IP. Each Cloudflare machine
  // counts on its own, so a client that opens a new connection per request
  // isn't limited (#88). The API limits guest accounts itself.
  "ratelimits": [
    { "name": "API_RATE_LIMIT", "namespace_id": "1001", "simple": { "limit": 100, "period": 60 } }
  ],
  // Custom Domains: deploys create their DNS records and certificates in the
  // fortymm.com zone, which must have no other A/AAAA/CNAME for these names.
  "routes": [
    { "pattern": "fortymm.com", "custom_domain": true },
    { "pattern": "www.fortymm.com", "custom_domain": true }
  ],
  // Give each Preview a <preview-name>-fortymm.mightymoose.workers.dev URL.
  // Without it, `wrangler preview` reports the Preview has no active URLs.
  "preview_urls": true,
  // Settings for `wrangler preview` (the Preview deploys CI makes for
  // branches). Previews get only the bindings listed here, so they repeat the
  // rate limit, with their own namespace so they don't share production's
  // counts.
  "previews": {
    "ratelimits": [
      { "name": "API_RATE_LIMIT", "namespace_id": "1002", "simple": { "limit": 100, "period": 60 } }
    ]
  }
}
