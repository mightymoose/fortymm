// Cloudflare Workers static assets: serves the Vite build in dist/.
// Deployed by `mise run web-client:deploy` (CI does it on pushes to main).
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fortymm",
  "compatibility_date": "2026-10-20",
  "assets": {
    "directory": "./dist",
    // Serve index.html for paths with no matching file, so client-side
    // (TanStack Router) routes work on a direct load or refresh.
    "not_found_handling": "single-page-application"
  },
  // Custom Domains: deploys create their DNS records and certificates in the
  // fortymm.com zone, which must have no other A/AAAA/CNAME for these names.
  "routes": [
    { "pattern": "fortymm.com", "custom_domain": true },
    { "pattern": "www.fortymm.com", "custom_domain": true }
  ],
  // Give each Preview a <preview-name>-fortymm.mightymoose.workers.dev URL.
  // Without it, `wrangler preview` reports the Preview has no active URLs.
  "preview_urls": true,
  // Required by `wrangler preview` (the Preview deploys CI makes for
  // branches); empty because Previews use the settings above.
  "previews": {}
}
