// Cloudflare Workers static assets: serves the Vite build in dist/.
// Deployed by `mise run web-client:deploy` (CI does it on pushes to main).
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fortymm",
  "compatibility_date": "2026-10-20",
  "assets": {
    "directory": "./dist",
    // Serve index.html for paths with no matching file, so client-side
    // (TanStack Router) routes work on a direct load or refresh.
    "not_found_handling": "single-page-application"
  }
}
